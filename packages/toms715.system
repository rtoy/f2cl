;;; -*- Mode: lisp -*-
;;;

(defparameter *toms715-root*
  (merge-pathnames
   #P"toms/715/"
   (make-pathname :host (pathname-host *load-truename*)
		  :directory (pathname-directory *load-truename*))))

(defparameter *toms715-fasl*
  (merge-pathnames #P"fasl/" *toms715-root*))

(mk:define-language :f2cl
    :compiler #'f2cl:f2cl-compile
    :source-extension "f")

;; On some (all?) x86 systems, machar doesn't correctly compute the
;; desired values.  This is due to the 80-bit floats on x86.
;; Non-x86 systems or x86 systems using SSE2 for floats can probably
;; compile and run the Fortran version without problems.
;;
;; For Lisps that use sse2, we don't need this lisp version anymore.
;; We can compile machar.f and produce the same results as Fortran.
#+(or)
(mk:defsystem machar
  :source-pathname (make-pathname :directory (pathname-directory *load-truename*))
  :source-extension "lisp"
  :components
  ((:file "machar")))

(mk:defsystem toms715
    :source-pathname *toms715-root*
    :binary-pathname *toms715-fasl*
    :source-extension "f"
    :language :f2cl
    ;; Uncomment this and the machar system above if you need the lisp
    ;; version of machar :depends-on ("machar")
    :compiler-options (:keep-lisp-file nil)
    :components
    (
     (:file "anorm")
     (:file "besei0" :depends-on ("calci0"))
     (:file "besei1" :depends-on ("calci1"))
     (:file "besek0" :depends-on ("calck0"))
     (:file "besek1" :depends-on ("calck1"))
     (:file "besi0" :depends-on ("calci0"))
     (:file "besi1" :depends-on ("calci1"))
     (:file "besj0" :depends-on ("caljy0"))
     (:file "besj1" :depends-on ("caljy1"))
     (:file "besk0" :depends-on ("calck0"))
     (:file "besk1" :depends-on ("calck1"))
     (:file "besy0" :depends-on ("caljy0"))
     (:file "besy1" :depends-on ("caljy1"))
     (:file "calcei")
     (:file "calci0")
     (:file "calci1")
     (:file "calck0")
     (:file "calck1")
     (:file "calerf")
     (:file "caljy0")
     (:file "caljy1")
     (:file "daw")
     (:file "derf")
     (:file "derfc")
     (:file "derfcx")
     (:file "dgamma")
     (:file "dlgama")
     (:file "dsubn")
     (:file "ei")
     (:file "eone")
     (:file "expei")
     ;; Use the Lisp equivalent.
     ;;(:file "machar")
     (:file "psi")
     (:file "ren")
     (:file "ribesl")
     (:file "rjbesl")
     (:file "rkbesl")
     (:file "rybesl")
     ))

;; Tests for TOMS 715.  The tests have the same name as the file
;; listed below.  Hence to run the J0 test, run (j0test).
(mk:defsystem toms715-tests
    :source-pathname *toms715-root*
    :binary-pathname *toms715-fasl*
    :source-extension "f"
    :language :f2cl
    :depends-on ("toms715")
    :compiler-options (:keep-lisp-file nil)
    :components
  ((:module "machar"
    :source-pathname ""
    :components
    (
     #+(and)
     (:file "machar")))
   (:module "test-progs"
    :source-pathname ""
    :depends-on ("machar")
    :components
    ((:file "algtst")
     (:file "anrtst")
     (:file "dawtst")
     (:file "eitest")
     (:file "erftst")
     (:file "gamtst")
     (:file "i0test")
     (:file "i1test")
     (:file "j0test")
     (:file "j1test")
     (:file "k0test")
     (:file "k1test")
     (:file "psitst")
     (:file "ritest")
     (:file "rjtest")
     (:file "rktest")
     (:file "rytest")
     (:file "y0test")
     (:file "y1test")
     ))))

