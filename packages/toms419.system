;;; -*- Mode: lisp -*-
;;;

(defparameter *toms419-root*
  (merge-pathnames
   #P"toms/419/"
   (make-pathname :name nil
                  :type nil
                  :defaults *load-truename*)))

(defparameter *toms419-fasl*
  (merge-pathnames #P"fasl/" *toms419-root*))
   
(mk:define-language :f2cl
    :compiler #'f2cl:f2cl-compile
    :source-extension "f")

(mk:defsystem toms419
    :source-pathname *toms419-root*
    :binary-pathname *toms419-fasl*
    :source-extension "f"
    :language :f2cl
    :compiler-options (:keep-lisp-file nil)
    :components
    (
     (:file "cpoly"
      :compiler-options (:declare-common t)
      :depends-on ("mcon" "cmod" "scale" "cdivid" "cauchy" "noshft" "fxshft"))
     (:file "noshft"
      :depends-on ("cmod" "cdivid"))
     (:file "fxshft"
      :depends-on ("polyev" "calct" "cmod" "vrshft"))
     (:file "vrshft"
      :depends-on ("polyev" "cmod" "errev" "calct" "nexth"))
     (:file "calct"
      :depends-on ("polyev" "cmod" "cdivid"))
     (:file "nexth")
     (:file "polyev")
     (:file "errev"
      :depends-on ("cmod"))
     (:file "cauchy")
     (:file "scale")
     (:file "cdivid"
      :depends-on ("mcon"))
     (:file "cmod")
     (:file "mcon")
     ))

;; Run (cpolydr) to run the test.
(mk:defsystem toms419-test
    :source-pathname *toms419-root*
    :binary-pathname *toms419-fasl*
    :source-extension "f"
    :language :f2cl
    :compiler-options (:keep-lisp-file nil)
    :depends-on ("toms419")
    :components
    (
     (:file "prtc")
     (:file "prtz")
     (:file "cpolydr")
     ))
