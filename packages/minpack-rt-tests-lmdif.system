;;; -*- Mode: lisp -*-
;;;
;;; mk-defsystem definition for the rt-based tst-lmdif regression
;;; tests.  Mirrors the ASDF "minpack-rt-tests/lmdif" system in
;;; minpack-rt-tests.asd.
;;;
;;; Named "minpack-rt-tests-lmdif" (dash, not slash) because
;;; mk-defsystem's central-registry lookup is by exact filename.
;;;
;;; CANNOT be loaded into the same Lisp image as
;;; minpack-rt-tests-hybrd: both tst-hybrd.f and tst-lmdif.f define
;;; top-level subroutines named FCN and INITPT with different
;;; signatures, so loading the second clobbers the first.

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defparameter *minpack-rt-tests-lmdif-root*
    (let ((load-path #-gcl *load-truename*
                     #+gcl sys:*load-truename*))
      (make-pathname :host (pathname-host load-path)
                     :device (pathname-device load-path)
                     :directory (append (pathname-directory load-path)
                                        '("minpack"))))))

(mk:defsystem minpack-rt-tests-lmdif
    :source-pathname *minpack-rt-tests-lmdif-root*
    :source-extension "lisp"
    :depends-on (f2cl minpack)
    :components
    ((:file "minpack-tests-package")
     (:file "minpack-tests-helpers"
            :depends-on ("minpack-tests-package"))
     (:file "tst-lmdif-test"
            :depends-on ("minpack-tests-helpers"))))
