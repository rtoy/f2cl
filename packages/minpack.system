;;; -*- Mode: lisp -*-
;;;
;;; Defsystem for compiling Minpack.

;; This is where the minpack source files are located.  This value
;; assumes the directory structure is
;;
;;   <path>
;;     minpack.system
;;     minpack/
;;       <minpack files>
(defparameter *minpack-root*
  (make-pathname :directory
                 (pathname-directory
                  (merge-pathnames #P"minpack/" *load-truename*))))

(mk:define-language :f2cl
    :compiler #'f2cl:f2cl-compile
    :source-extension "f")

(mk:defsystem minpack
    :source-pathname *minpack-root*
    :components
    ((:file "minpack"
	    :source-extension "lisp"
	    :language :lisp)
     (:module "minpack"
	      :source-pathname ""
	      :source-extension "f"
	      :package :minpack
	      :language :f2cl
	      :compiler-options (:include-comments t
				 :keep-lisp-file t
				 :relaxed-array-decls nil
				 :array-type :array
				 :array-slicing t
				 :package :minpack)
	      :components
	      (
	       (:file "dpmpar")
	       (:file "enorm")
	       (:file "fdjac1" :depends-on ("dpmpar"))
	       (:file "fdjac2" :depends-on ("dpmpar"))
	       (:file "qrsolv")
	       (:file "lmpar" :depends-on ("dpmpar" "enorm" "qrsolv"))
	       (:file "qrfac" :depends-on ("dpmpar" "enorm"))
	       (:file "lmdif" :depends-on ("dpmpar" "enorm" "fdjac2" "lmpar" "qrfac"))
	       (:file "lmdif1" :depends-on ("lmdif"))
	       (:file "lmder" :depends-on ("dpmpar" "enorm" "lmpar" "qrfac"))
	       (:file "lmder1" :depends-on ("lmder"))
	       (:file "dogleg" :depends-on ("dpmpar" "enorm"))
	       (:file "qform")
	       (:file "r1mpyq")
	       (:file "r1updt" :depends-on ("dpmpar"))
	       (:file "hybrd" :depends-on ("dogleg" "dpmpar" "enorm" "fdjac1"
					   "qform" "qrfac" "r1mpyq" "r1updt"))
	       (:file "hybrd1" :depends-on ("hybrd"))
	       (:file "hybrj" :depends-on ("dogleg" "dpmpar" "enorm" "qform" "qrfac"
						    "r1mpyq" "r1updt"))
	       (:file "hybrj1" :depends-on ("hybrj"))
	       ))))

;; (minpack::run-minpack-tests) will run the tst-lmdif and tst-lmder
;; tests.  (When the STOP statement is reached, select the continue
;; restart to continue.)  Compare the output in tlmdif.txt to
;; lmdif-ref.txt and tlmder.txt to lmder-ref.txt.
(mk:defsystem minpack-tests
    :source-pathname *minpack-root*
    :components
    ((:module "main"
	      :source-pathname ""
	      :source-extension "lisp"
	      :package :minpack
	      :components
	      ((:file "run-minpack-tests")))
     (:module "tests"
	      :source-pathname ""
	      :source-extension "f"
	      :package :minpack
	      :language :f2cl
	      :compiler-options (:include-comments t
				 :keep-lisp-file t
				 :relaxed-array-decls nil
				 :array-type :array
				 :array-slicing t
				 :package :minpack
				 :declare-common t)
	      :components
	      ((:file "tst-lmdif")
	       (:file "tst-lmder")))))

;; This test defines things that are incompatible with tst-lmdif and
;; tst-lmder.  Hence, you can't run this test with others.

(mk:defsystem minpack-test-hybrd
    :source-pathname *minpack-root*
    :components
    ((:module "main"
	      :source-pathname ""
	      :source-extension "lisp"
	      :package :minpack
	      :components
	      ((:file "run-minpack-tests")))
     (:module "tests"
	      :source-pathname ""
	      :source-extension "f"
	      :package :minpack
	      :language :f2cl
	      :compiler-options (:include-comments t
				 :keep-lisp-file t
				 :relaxed-array-decls nil
				 :array-type :array
				 :array-slicing t
				 :package :minpack
				 :declare-common t)
	      :components
	       (:file "tst-hybrd"))))

;;; System to convert the Fortran code to Lisp

(mk:define-language :f2cl-lisp
    :compiler #'f2cl:f2cl
    :loader #'identity
    :source-extension "f"
    :binary-extension "lisp")

(mk:defsystem minpack-lisp
    :source-pathname *minpack-root*
    :components
    ((:file "minpack"
	    :source-extension "lisp"
	    :language :lisp)
     (:module "minpack"
	      :source-pathname ""
	      :source-extension "f"
              :binary-pathname "lib/"
	      :package :minpack
	      :language :f2cl-lisp
	      :compiler-options (:include-comments t
				 :relaxed-array-decls nil
				 :array-type :array
				 :array-slicing t
				 :package :minpack)
	      :components
	      (
	       (:file "dpmpar")
	       (:file "enorm")
	       (:file "fdjac1" :depends-on ("dpmpar"))
	       (:file "fdjac2" :depends-on ("dpmpar"))
	       (:file "qrsolv")
	       (:file "lmpar" :depends-on ("dpmpar" "enorm" "qrsolv"))
	       (:file "qrfac" :depends-on ("dpmpar" "enorm"))
	       (:file "lmdif" :depends-on ("dpmpar" "enorm" "fdjac2" "lmpar" "qrfac"))
	       (:file "lmdif1" :depends-on ("lmdif"))
	       (:file "lmder" :depends-on ("dpmpar" "enorm" "lmpar" "qrfac"))
	       (:file "lmder1" :depends-on ("lmder"))
	       (:file "dogleg" :depends-on ("dpmpar" "enorm"))
	       (:file "qform")
	       (:file "r1mpyq")
	       (:file "r1updt" :depends-on ("dpmpar"))
	       (:file "hybrd" :depends-on ("dogleg" "dpmpar" "enorm" "fdjac1"
					   "qform" "qrfac" "r1mpyq" "r1updt"))
	       (:file "hybrd1" :depends-on ("hybrd"))
	       (:file "hybrj" :depends-on ("dogleg" "dpmpar" "enorm" "qform" "qrfac"
						    "r1mpyq" "r1updt"))
	       (:file "hybrj1" :depends-on ("hybrj"))
	       ))))
