;;; -*- Mode: lisp -*-
;;;
;;; This is a simple defsystem for converting QUADPACK Fortran
;;; routines to Lisp and compiling the result.
;;;
;;; $Id$
;;; $Log$
;;; Revision 1.11  2008/09/15 19:18:05  rtoy
;;; o Make *quadpack-root* work for gcl
;;; o Forgot to specify the source extension for quadpack-test.
;;;
;;; Revision 1.10  2008/08/25 16:53:32  rtoy
;;; o Get rid of the logical pathname translations.
;;; o Define *QUADPACK-ROOT* to hold the directory containing
;;;   quadpack.system.
;;;
;;; Revision 1.9  2008/03/12 15:58:06  rtoy
;;; Fixup the quadpack-lisp system to generate just the lisp files in the
;;; slatec package.
;;;
;;; Revision 1.8  2008/02/25 19:40:46  rtoy
;;; o Clean up definition of quadpack logical host.
;;; o Remove unused code.
;;; o Add system for quadpack-test.
;;;
;;; Revision 1.7  2006/04/28 01:12:58  rtoy
;;; Use *load-pathname to construct the source path (f2cl.system) or a
;;; logical pathname to use in the defsystems so that each defsystem can
;;; find its own files.
;;;
;;; Revision 1.6  2003/09/25 04:05:55  rtoy
;;; Compute the necessary translation for the Fortran directory from the
;;; current translation for clocc instead of hard-wiring the path.
;;;
;;; Revision 1.5  2002/03/19 23:28:32  rtoy
;;; Add a defsystem to compile the Fortran codes directly via
;;; f2cl-compile.  Leave the old defsystem around, but with a new name.
;;;
;;; Revision 1.4  2000/08/07 17:02:29  rtoy
;;; Comment out unused functions, make it more palatable to Clisp logical
;;; pathnames, add some dependencies.
;;;
;;; Revision 1.3  2000/07/21 22:12:35  rtoy
;;; :ARRAY-SLICING should default to NIL.
;;;
;;; Revision 1.2  2000/07/21 17:48:29  rtoy
;;; Add some support for :compiler-options if MK defsystem supports it.
;;;
;;; Revision 1.1  2000/07/20 15:42:18  rtoy
;;; Initial revision
;;;
;;;

;; Quadpack root directory, basically the directory containing
;; quadpack.system.
(defparameter *quadpack-root*
  (let ((load-path #-gcl *load-truename*
		   #+gcl sys:*load-truename*))
    (make-pathname :host (pathname-host load-path)
		   :directory (pathname-directory load-path))))


;; Defsystem for d1mach and i1mach
(mk:defsystem mach-par
    :source-pathname *quadpack-root*
    :source-extension "lisp"
    :components
    ((:file "d1mach")
     (:file "i1mach")))


;; Symbols emitted by f2cl-compile go into the QUADPACK package.
;; (Was nil historically, which put the symbols into cl-user; the
;; new test system below references quadpack:dqag etc., so we need
;; them in the proper package.)
(defvar *quadpack-package* :quadpack)

;; Wrapper that adds :package *quadpack-package* to whatever else
;; mk's compile-language flow passes in.  Uses &allow-other-keys
;; rather than enumerating the f2cl-compile arglist so future
;; additions to f2cl-compile don't require updates here.
(defun quadpack-compile (filename &rest args &key &allow-other-keys)
  (apply #'f2cl:f2cl-compile filename
	 :package *quadpack-package*
	 args))

;; The :f2cl mk-defsystem language used to be wired directly to
;; f2cl:f2cl-compile, which dropped the :package argument and put
;; quadpack symbols in cl-user.  Route through quadpack-compile
;; instead so *quadpack-package* takes effect.
(mk:define-language :f2cl
    :compiler #'quadpack-compile
    :source-extension "f")

;; Defsystem for quadpack.
(mk:defsystem quadpack
    :source-pathname (merge-pathnames "quadpack"
				      *quadpack-root*)
    :depends-on ("mach-par")
    :components
    (;; Defines the :quadpack and :quadpack-tests packages.  Loaded
     ;; first so the package exists before any quadpack files
     ;; compile (and the in-package form at the top of generated
     ;; sources resolves).  Same file is referenced from
     ;; quadpack.asd.
     (:file "quadpack-package" :source-extension "lisp")
     (:module Fortran
	      :source-pathname "fortran"
	      :binary-pathname "lib/"
	      :source-extension "f"
	      :language :f2cl
	      :depends-on ("quadpack-package")
	      :components
	      (
	       ;; Support
	       (:file "dqwgtf")
	       (:file "dqcheb")
	       (:file "dqk15w")
	       (:file "dqwgts")
	       (:file "dqwgtc")
	       (:file "dgtsl")
	       (:file "xerror"
                :depends-on ("xerrwv"))
               (:file "xerrwv"
                :depends-on ("j4save" "xerprt" "xerabt" "xgetua" "xerctl" "fdump" "xersav"))
               (:file "j4save")
               (:file "xerprt")
               (:file "xerabt")
               (:file "xgetua")
               (:file "xerctl")
               (:file "xersav")
               (:file "fdump")
               (:file "xermsg"
                      :depends-on ("xerprn" "xersve" "xerhlt" "xercnt"))
               (:file "xerprn")
               (:file "xersve")
               (:file "xerhlt")
               (:file "xercnt")
	       
	       ;; Core integration routines
	       (:file "dqk15")
	       (:file "dqk31")
	       (:file "dqk41")
	       (:file "dqk51")
	       (:file "dqk61")
	       (:file "dqk21")
	       (:file "dqk15i")
	       (:file "dqelg")
	       (:file "dqpsrt")
	       (:file "dqc25s"
		      :depends-on ("dqcheb" "dqk15w"))
	       (:file "dqmomo")
	       (:file "dqc25c"
		      :depends-on ("dqcheb"
				   "dqk15w"))
	       (:file "dqc25f"
		      :depends-on ("dgtsl"
				   "dqcheb"
				   "dqk15w"
				   "dqwgtf"))
	       ;; Basic integrators
	       (:file "dqage"
		      :depends-on ("dqk15"
				   "dqk31"
				   "dqk41"
				   "dqk51"
				   "dqk61"
				   "dqk21"
				   "dqpsrt"))
	       (:file "dqagie"
		      :depends-on ("dqelg"
				   "dqk15i"
				   "dqpsrt"))
	       (:file "dqagp"
		      :depends-on ("dqagpe" "xermsg")
		      :compiler-options (:array-slicing nil :array-type :array
					 :float-format double-float
					 #|:package :slatec|#))
	       (:file "dqagpe"
		      :depends-on ("dqelg"
				   "dqpsrt"
				   "dqk21"
				   ))
	       (:file "dqagse"
		      :depends-on ("dqk21"
				   "dqelg"
				   "dqpsrt"))
	       (:file "dqawfe"
		      :depends-on ("dqagie"
				   "dqawoe"
				   "dqelg")
		      ;; If your defsystem doesn't support :compiler-options, use this:
		      ;; :language :f2cl-no-slice
		      ;; If your defsystem does support :compiler-options, use this:
		      :compiler-options (:array-slicing nil :array-type :array)
		      )
	       (:file "dqawoe"
		      :depends-on ("dqc25f"
				   "dqpsrt"
				   "dqelg"))
	       (:file "dqawse"
		      :depends-on ("dqc25s"
				   "dqmomo"
				   "dqpsrt"))
	       (:file "dqawce"
		      :depends-on ("dqc25c"
				   "dqpsrt"))
	       ;; Simplified interface routines
	       (:file "dqng"
		      :depends-on ("xerror"))
	       (:file "dqag"
		      :depends-on ("dqage"
				   "xerror"))
	       (:file "dqags"
		      :depends-on ("dqagse"
				   "xerror"))
	       (:file "dqagi"
		      :depends-on ("dqagie"
				   "xerror"))
	       (:file "dqawf"
		      :depends-on ("dqawfe"
				   "xerror"))
	       (:file "dqawo"
		      :depends-on ("dqawoe"
				   "xerror"))
	       (:file "dqaws"
		      :depends-on ("dqawse"
				   "xerror"))
	       (:file "dqawc"
		      :depends-on ("dqawce"
				   "xerror"))))))

;; Simple test for quadpack.  Run (do-tests) to run all of the tests.
;; If you have TOMS 715 loaded, you can get comparisons between the
;; quadpack values and the true values for some of the tests where the
;; true value is in terms of Bessel functions.
;;
;; The newer rt-based quadpack tests (mirroring what the ASDF
;; quadpack/tests system runs) live in their own mk-defsystem file,
;; packages/quadpack-tests.system, since mk-defsystem's central
;; registry discovery requires <system-name>.system filenames.
(mk:defsystem quadpack-test
    :source-pathname (merge-pathnames "quadpack"
				      *quadpack-root*)
    :source-extension "lisp"
    :depends-on ("mach-par" "quadpack")
    :components
    ((:file "quadpack-tests")))


;;; System to convert the Fortran code to Lisp

(mk:define-language :f2cl-lisp
    :compiler #'f2cl:f2cl
    :loader #'identity
    :source-extension "f"
    :binary-extension "lisp")

(mk:defsystem quadpack-lisp
    :source-pathname (merge-pathnames "quadpack/fortran"
				      *quadpack-root*)
    :depends-on ("mach-par")
    :compiler-options (:array-slicing nil
		       :array-type :simple-array
		       :float-format double-float
		       :package :slatec)
    :language :f2cl-lisp
    :compile-only t
    :components
    ((:module Fortran
	      :source-pathname ""
	      :binary-pathname "lib/"
	      :source-extension "f"
	      :components
	      (
	       ;; Support
	       (:file "dqwgtf")
	       (:file "dqcheb")
	       (:file "dqk15w")
	       (:file "dqwgts")
	       (:file "dqwgtc")
	       (:file "dgtsl")
	       (:file "xerror"
                :depends-on ("xerrwv"))
               (:file "xerrwv"
                :depends-on ("j4save" "xerprt" "xerabt" "xgetua" "xerctl" "fdump" "xersav"))
               (:file "j4save")
               (:file "xerprt")
               (:file "xerabt")
               (:file "xgetua")
               (:file "xerctl")
               (:file "xersav")
               (:file "fdump")
               (:file "xermsg"
                      :depends-on ("xerprn" "xersve" "xerhlt" "xercnt"))
               (:file "xerprn")
               (:file "xersve")
               (:file "xerhlt")
               (:file "xercnt")
               
	       ;; Core integration routines
	       (:file "dqk15")
	       (:file "dqk31")
	       (:file "dqk41")
	       (:file "dqk51")
	       (:file "dqk61")
	       (:file "dqk21")
	       (:file "dqk15i")
	       (:file "dqelg")
	       (:file "dqpsrt")
	       (:file "dqc25s"
		      :depends-on ("dqcheb" "dqk15w"))
	       (:file "dqmomo")
	       (:file "dqc25c"
		      :depends-on ("dqcheb"
				   "dqk15w"))
	       (:file "dqc25f"
		      :depends-on ("dgtsl"
				   "dqcheb"
				   "dqk15w"
				   "dqwgtf"))
	       ;; Basic integrators
	       (:file "dqage"
		      :depends-on ("dqk15"
				   "dqk31"
				   "dqk41"
				   "dqk51"
				   "dqk61"
				   "dqk21"
				   "dqpsrt"))
	       (:file "dqagie"
		      :depends-on ("dqelg"
				   "dqk15i"
				   "dqpsrt"))
	       (:file "dqagp"
		      :depends-on ("dqagpe" "xermsg")
		      :compiler-options (:array-slicing t :array-type :array
					 :float-format double-float
					 :package :slatec))
	       (:file "dqagpe"
		      :depends-on ("dqelg"
				   "dqpsrt"
				   "dqk21"
				   ))
	       (:file "dqagse"
		      :depends-on ("dqk21"
				   "dqelg"
				   "dqpsrt"))
	       (:file "dqawfe"
		      :depends-on ("dqagie"
				   "dqawoe"
				   "dqelg")
		      ;; If your defsystem doesn't support :compiler-options, use this:
		      ;; :language :f2cl-no-slice
		      ;; If your defsystem does support :compiler-options, use this:
		      :compiler-options (:array-slicing nil :array-type :array
					 :float-format double-float
					 :package :slatec))
	       (:file "dqawoe"
		      :depends-on ("dqc25f"
				   "dqpsrt"
				   "dqelg"))
	       (:file "dqawse"
		      :depends-on ("dqc25s"
				   "dqmomo"
				   "dqpsrt"))
	       (:file "dqawce"
		      :depends-on ("dqc25c"
				   "dqpsrt"))
	       ;; Simplified interface routines
	       (:file "dqng"
		      :depends-on ("xerror"))
	       (:file "dqag"
		      :depends-on ("dqage"
				   "xerror"))
	       (:file "dqags"
		      :depends-on ("dqagse"
				   "xerror"))
	       (:file "dqagi"
		      :depends-on ("dqagie"
				   "xerror"))
	       (:file "dqawf"
		      :depends-on ("dqawfe"
				   "xerror"))
	       (:file "dqawo"
		      :depends-on ("dqawoe"
				   "xerror"))
	       (:file "dqaws"
		      :depends-on ("dqawse"
				   "xerror"))
	       (:file "dqawc"
		      :depends-on ("dqawce"
				   "xerror"))))))
