;;; -*- Mode: lisp -*-
;;;
;;; mk-defsystem definition for the rt-based minpack regression
;;; tests.
;;;
;;; Mirrors the ASDF "minpack-rt-tests" system in minpack-rt-tests.asd:
;;; loads tst-hybrd-test.lisp which registers an rt:deftest;
;;; running it is left to the caller's (rt:do-tests).
;;;
;;; Lives in its own file (not inside packages/minpack.system) because
;;; mk-defsystem's central-registry discovery looks for
;;; <system-name>.system on disk -- so a system named "minpack-rt-tests"
;;; has to live in "minpack-rt-tests.system" to be findable that way.
;;;
;;; Named "minpack-rt-tests" rather than "minpack-tests" to avoid
;;; colliding with the existing (mk:defsystem minpack-tests ...) in
;;; packages/minpack.system, which is a different thing entirely:
;;; that one builds tst-lmdif.f and tst-lmder.f and is driven by
;;; (minpack::run-minpack-tests) writing to .txt files.  This one
;;; is for the RT-based exact-match regression test of tst-hybrd
;;; output.
;;;
;;; Depends on:
;;;   f2cl              -- the translator (needed for f2cl-compile
;;;                        to be a resolvable symbol when
;;;                        minpack.system loads)
;;;   minpack           -- the f2cl-translated minpack library,
;;;                        defined in packages/minpack.system

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defparameter *minpack-rt-tests-root*
    (let ((load-path #-gcl *load-truename*
                     #+gcl sys:*load-truename*))
      (make-pathname :host (pathname-host load-path)
                     :device (pathname-device load-path)
                     :directory (append (pathname-directory load-path)
                                        '("minpack"))))))

(mk:defsystem minpack-rt-tests
    :source-pathname *minpack-rt-tests-root*
    :source-extension "lisp"
    :depends-on (f2cl minpack)
    :components
    ((:file "minpack-tests-package")
     (:file "tst-hybrd-test"
            :depends-on ("minpack-tests-package"))))
