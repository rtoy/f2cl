;;; -*- Mode: lisp -*-

;; A sample defsystem.

(eval-when (compile load eval)
  (defparameter *f2cl-root*
    (let ((load-path #-gcl *load-truename*
		     #+gcl sys:*load-truename*))
      (make-pathname :host (pathname-host load-path)
		     :directory (pathname-directory load-path))))
  ;; Make packages/*.system files findable by mk's central-registry.
  ;; Every .system file in there is named after the system it defines
  ;; (quadpack.system->quadpack, quadpack-tests.system->quadpack-tests,
  ;; etc.), so registry discovery works.
  (pushnew (merge-pathnames "packages/" *f2cl-root*)
           mk::*central-registry*
           :test #'equalp))

(defun %run-rt-tests (label)
  "Run RT's deftests and signal on unexpected outcomes.  Shared
between the f2cl-tests and fortran-format-tests systems below.
LABEL appears in the error message so the user can see which
suite produced surprises.

Fires after every mk:oos invocation (compile or load).  We only
want it to do work when the regression-test files have actually
been loaded into the image -- if entries-table is empty, either
RT didn't load yet (compile pass under some configurations) or
no tests.lisp was loaded, and \"0 out of 0\" isn't useful."
  (let ((rt (find-package :regression-test)))
    (when rt
      (let ((pending-fn    (find-symbol "PENDING-TESTS"      rt))
            (do-tests-fn   (find-symbol "DO-TESTS"           rt))
            (expected-var  (find-symbol "*EXPECTED-FAILURES*" rt))
            (entries-table (find-symbol "*ENTRIES-TABLE*"    rt)))
        (when (and entries-table
                   (boundp entries-table)
                   (plusp (hash-table-count
                           (symbol-value entries-table))))
          (funcall do-tests-fn)
          (let* ((total    (hash-table-count (symbol-value entries-table)))
                 (pending  (funcall pending-fn))
                 (expected (and (boundp expected-var)
                                (symbol-value expected-var)))
                 (failed     (length pending))
                 (passed     (- total failed))
                 (unexpected (set-difference pending expected))
                 (surprises  (set-difference expected pending)))
            (when unexpected
              (format t "~&~A: unexpected failures:~%" label)
              (dolist (sym unexpected)
                (format t "  ~A~%" sym)))
            (when surprises
              (format t "~&~A: unexpected successes:~%" label)
              (dolist (sym surprises)
                (format t "  ~A~%" sym)))
            (format t "~&~A: ~D test~:P, ~D passed, ~D failed~%~
                       ~2T~D expected failure~:P~%~
                       ~2T~D unexpected failure~:P~%~
                       ~2T~D unexpected ~:[successes~;success~]~%"
                    label total passed failed
                    (length expected)
                    (length unexpected)
                    (length surprises) (= (length surprises) 1))
            (when (or unexpected surprises)
              (error "~A: ~D unexpected failure~:P, ~D unexpected ~:[successes~;success~]"
                     label (length unexpected) (length surprises)
                     (= (length surprises) 1)))))))))

(defun run-f2cl-tests ()
  "Wired into the f2cl-tests mk system below as :finally-do, and
mirrors the :perform method on f2cl/tests in f2cl.asd."
  (%run-rt-tests "f2cl-tests"))

(defun run-fortran-format-tests ()
  "Wired into the fortran-format-tests mk system below as
:finally-do, and mirrors the :perform method on
f2cl/fortran-format/tests in f2cl.asd."
  (%run-rt-tests "fortran-format-tests"))

(mk:defsystem f2cl
  :source-pathname *f2cl-root*
  :depends-on ("fortran-format")
  :components
  ((:module pkg
    :source-pathname "src"
    :components
    ((:file "f2cl-package")
     (:file "f2cl-lib-package")))
   (:module src
    :depends-on (pkg)
    :components
    (
     (:file "f2cl-lib")
     (:file "f2cl1")
     (:file "f2cl2")
     (:file "f2cl4")
     (:file "f2cl5")
     (:file "f2cl6")
     (:file "f2cl7")
     #+cmu(:file "f2cl8")
     (:file "f2cl-lib")))))

(mk:defsystem fortran-format
  :source-pathname (merge-pathnames "src/" *f2cl-root*)
  :components
  ((:module format
    :components
    ((:file "package")
     (:file "fortran-format-parser"
            :depends-on ("package"))
     (:file "fortran-format-io"
      :depends-on ("package" "fortran-format-parser"))))))

(mk:defsystem fortran-format-tests
  :source-pathname (merge-pathnames "src/" *f2cl-root*)
  :depends-on ("fortran-format" "rt")
  :components
  ((:module format
    :components
    ((:file "fortran-format-corpus")
     ;; Generated corpus tests; mirrors the ASDF wiring in f2cl.asd.
     ;; Each pair of files is the auto-generated deftests followed by
     ;; the hand-maintained expected-failures list for that file.
     (:module "corpus/gfortran-4.4.1"
      :depends-on ("fortran-format-corpus")
      :components
      ((:file "i-ed-output.tests")
       (:file "i-ed-output.expected-failures"
              :depends-on ("i-ed-output.tests"))
       (:file "f-ed-output.tests")
       (:file "f-ed-output.expected-failures"
              :depends-on ("f-ed-output.tests"))
       (:file "e-ed-output.tests")
       (:file "e-ed-output.expected-failures"
              :depends-on ("e-ed-output.tests"))
       (:file "a-ed-output.tests")
       (:file "a-ed-output.expected-failures"
              :depends-on ("a-ed-output.tests"))
       (:file "g-ed-output.tests")
       (:file "g-ed-output.expected-failures"
              :depends-on ("g-ed-output.tests"))
       (:file "d-ed-output.tests")
       (:file "d-ed-output.expected-failures"
              :depends-on ("d-ed-output.tests"))
       (:file "l-ed-output.tests")
       (:file "l-ed-output.expected-failures"
              :depends-on ("l-ed-output.tests"))
       (:file "b-ed-output.tests")
       (:file "b-ed-output.expected-failures"
              :depends-on ("b-ed-output.tests"))
       (:file "o-ed-output.tests")
       (:file "o-ed-output.expected-failures"
              :depends-on ("o-ed-output.tests"))
       (:file "z-ed-output.tests")
       (:file "z-ed-output.expected-failures"
              :depends-on ("z-ed-output.tests"))
       (:file "sp-a-ed-output.tests")
       (:file "sp-a-ed-output.expected-failures"
              :depends-on ("sp-a-ed-output.tests"))
       (:file "sp-b-ed-output.tests")
       (:file "sp-b-ed-output.expected-failures"
              :depends-on ("sp-b-ed-output.tests"))
       (:file "sp-d-ed-output.tests")
       (:file "sp-d-ed-output.expected-failures"
              :depends-on ("sp-d-ed-output.tests"))
       (:file "sp-e-ed-output.tests")
       (:file "sp-e-ed-output.expected-failures"
              :depends-on ("sp-e-ed-output.tests"))
       (:file "sp-f-ed-output.tests")
       (:file "sp-f-ed-output.expected-failures"
              :depends-on ("sp-f-ed-output.tests"))
       (:file "sp-g-ed-output.tests")
       (:file "sp-g-ed-output.expected-failures"
              :depends-on ("sp-g-ed-output.tests"))
       (:file "sp-i-ed-output.tests")
       (:file "sp-i-ed-output.expected-failures"
              :depends-on ("sp-i-ed-output.tests"))
       (:file "sp-l-ed-output.tests")
       (:file "sp-l-ed-output.expected-failures"
              :depends-on ("sp-l-ed-output.tests"))
       (:file "sp-o-ed-output.tests")
       (:file "sp-o-ed-output.expected-failures"
              :depends-on ("sp-o-ed-output.tests"))
       (:file "sp-z-ed-output.tests")
       (:file "sp-z-ed-output.expected-failures"
              :depends-on ("sp-z-ed-output.tests"))))
     (:file "fortran-format-tests" :depends-on ("fortran-format-corpus")))))
  :finally-do (run-fortran-format-tests))

;; Regression-test system.
;;
;; The user-visible flow:
;;
;;   (load "/path/to/mk-defsystem/defsystem.lisp")
;;   (setf mk::*bother-user-if-no-binary* nil
;;         mk::*compile-during-load*      t)
;;   (load "/path/to/f2cl/f2cl.system")
;;   (mk:oos :f2cl :load)            ; build f2cl first; quadpack.system
;;                                   ; reads f2cl: symbols at read time
;;   (load "/path/to/f2cl/packages/quadpack.system")
;;   (mk:oos :f2cl-tests :load)
;;
;; That last :load operation builds RT, the regression helpers and
;; tests, and (via the quadpack-tests dependency, found through mk's
;; central registry as packages/quadpack-tests.system) the
;; f2cl-translated quadpack tests.  Then -- via the :finally-do hook
;; below -- it runs (rt:do-tests), which sees both regression and
;; quadpack tests in RT's table, and signals if anything failed
;; unexpectedly.  Mirrors the :perform method of f2cl/tests in
;; f2cl.asd.

;; Compute the regression directory once for both rt and f2cl-tests
;; below.  Same pattern as packages/quadpack.system: an explicit
;; (make-pathname :host ... :directory ...) so all pathname slots
;; that aren't directory ones come out NIL rather than inheriting
;; from *default-pathname-defaults* (which on some lisps causes mk's
;; binary-path computation to double up the directory).
(defparameter *f2cl-regression-root*
  (let ((load-path #-gcl *load-truename*
		   #+gcl sys:*load-truename*))
    (make-pathname :host (pathname-host load-path)
		   :device (pathname-device load-path)
		   :directory (append (pathname-directory load-path)
				      '("regression")))))

;; Vendored ansi-test RT, broken out so f2cl-tests can :depends-on
;; it the same way the ASDF f2cl/tests does.  Source files live in
;; regression/ alongside helpers.lisp and tests.lisp.
(mk:defsystem rt
  :source-pathname *f2cl-regression-root*
  :depends-on nil
  :components
  ((:file "rt-package" :source-extension "lsp")
   (:file "rt"         :source-extension "lsp")))

(mk:defsystem f2cl-tests
  :source-pathname *f2cl-regression-root*
  :depends-on (f2cl rt quadpack-tests)
  :components
  ((:file "helpers")
   (:file "tests")
   (:file "test-fortran-format")
   (:file "test-fortran-format-read"))
  ;; mk-defsystem 3.9.2 wraps :finally-do's value in (lambda () ...)
  ;; at defsystem-expansion time, so don't use a lambda here.
  ;; Hopefully, this will get fixed someday.
  :finally-do (run-f2cl-tests))

;; Older mk-defsystem versions have a bug in
;; preprocess-component-definition that drops :finally-do's value
;; before the wrapping lambda's body is built, leaving the slot at
;; (lambda () nil) regardless of what was passed.  MK-defsys 3.9.2 has fixed this.
(setf (mk::component-finally-do (mk:find-system :f2cl-tests))
      (lambda () (run-f2cl-tests)))
